{
  "name": "OCaml Development (Rocq, Local Build)",

  "build": {
    "dockerfile": "../rocq/Dockerfile",
    "context": "..",
    "args": {
      "BASE_IMAGE": "ocaml-devcontainer:latest"
    }
  },

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ocamllabs.ocaml-platform"
      ],
      "settings": {
        "ocaml.sandbox": {
          "kind": "opam",
          "switch": "ocaml"
        }
      }
    }
  },

  "remoteUser": "vscode",

  "mounts": [
    "source=dune-cache,target=/home/vscode/.cache/dune,type=volume"
  ],

  "remoteEnv": {
    "DUNE_CACHE_ROOT": "/home/vscode/.cache/dune"
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
